{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalForPickle",
  "version": "0.1.1",
  "identifier": "com.calforpickle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CalForPickle",
        "width": 1100,
        "height": 680,
        "center": true,
        "minWidth": 480,
        "minHeight": 480,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "maximizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
